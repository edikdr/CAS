# Copy to .env and fill in. .env is gitignored and never reaches the site.
#
# A free, read-only "client access token" from https://genius.com/api-clients.
# This is the only credential the project uses. The client secret is only for
# logging users in on your behalf, which nothing here does — do not put it here.
GENIUS_ACCESS_TOKEN=

# Optional, only for server.js. Any host that sets PORT (most do) is fine.
PORT=8080
