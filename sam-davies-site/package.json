{
  "name": "sam-davies-scroll-story",
  "private": true,
  "type": "module",
  "description": "Unofficial fan concept site — dev tooling only; site/ has zero runtime deps",
  "scripts": {
    "build": "node tools/build-assets.mjs",
    "build:video": "node tools/build-assets.mjs --video",
    "data": "node tools/make-data.mjs",
    "check": "node tools/check-i18n.mjs && node tools/check-fonts.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test": "node --test tests/unit/*.test.mjs && playwright test",
    "serve": "node tools/serve.mjs",
    "lyrics:estimate": "node tools/transcribe-scribe.mjs --estimate",
    "apply-config": "node tools/apply-config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "sharp": "0.34.5"
  }
}
