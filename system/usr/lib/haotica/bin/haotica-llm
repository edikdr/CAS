#!/bin/sh
# HAOTICA: запуск llama-server для роли base | deep | fast (параметры — из манифеста и настроек)
export PYTHONPATH="/usr/lib/haotica/python${PYTHONPATH:+:$PYTHONPATH}"
PY="/opt/haotica/venv/bin/python3"
[ -x "$PY" ] || PY="/usr/bin/python3"
exec "$PY" -c 'import sys; from haotica.models import launch; launch(sys.argv[1])' "${1:-base}"
