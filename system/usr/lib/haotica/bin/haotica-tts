#!/bin/sh
# HAOTICA: служба голоса (Piper / Chatterbox) в отдельном окружении /opt/haotica/tts-venv
export PYTHONPATH="/usr/lib/haotica/python${PYTHONPATH:+:$PYTHONPATH}"
PY=/opt/haotica/tts-venv/bin/python
[ -x "$PY" ] || { echo "голос не установлен: ./install.sh --only 55 --force" >&2; exit 1; }
exec "$PY" -m haotica.tts "$@"
