[Unit]
Description=Haotica: ассистент (чат, инструменты, память, облачный канал)
PartOf=graphical-session.target
After=graphical-session.target haotica-core.service
# модели (haotica-llm-*) Haotica запускает сама, когда их файлы скачаны

[Service]
Type=simple
ExecStart=/usr/bin/haotica-agent
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=haotica-session.target
