[Unit]
Description=HAOTICA: оболочка (панель, док, HUD, лаунчер, уведомления)
PartOf=graphical-session.target
After=graphical-session.target haotica-core.service
Wants=haotica-core.service

[Service]
Type=simple
ExecStart=/usr/bin/qs -p /usr/share/haotica/shell
Restart=on-failure
RestartSec=1
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_QUICK_CONTROLS_STYLE=Basic

[Install]
WantedBy=haotica-session.target
