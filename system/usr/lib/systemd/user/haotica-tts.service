[Unit]
Description=HAOTICA: голос Haotica (Chatterbox с голосом Сары, запасной Piper)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/haotica/bin/haotica-tts
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
Nice=3

[Install]
WantedBy=haotica-session.target
