[Unit]
Description=HYPERINA: быстрая модель подсказок — llama.cpp (Vulkan)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/hyperina/bin/hyperina-llm fast
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
Nice=5
# модели живут в общей памяти с GPU: держим их вне swap
LimitMEMLOCK=infinity

[Install]
WantedBy=hyperina-session.target
