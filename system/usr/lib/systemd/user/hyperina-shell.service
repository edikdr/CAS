[Unit]
Description=HYPERINA: оболочка (панель, док, HUD, лаунчер, уведомления)
PartOf=graphical-session.target
After=graphical-session.target hyperina-core.service
Wants=hyperina-core.service

[Service]
Type=simple
ExecStart=/usr/bin/qs -p /usr/share/hyperina/shell
Restart=on-failure
RestartSec=1
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_QUICK_CONTROLS_STYLE=Basic

[Install]
WantedBy=hyperina-session.target
