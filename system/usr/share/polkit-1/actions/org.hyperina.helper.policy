<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- HYPERINA: действия hyperina-helper. Без пароля — только безопасные действия активного сеанса. -->
<policyconfig>
  <vendor>HYPERINA</vendor>
  <icon_name>hyperina-security</icon_name>
  <action id="org.hyperina.helper.recon">
    <description>Сканирование своей локальной сети</description>
    <message>HYPERINA: сканирование своей локальной сети — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">recon</annotate>
  </action>
  <action id="org.hyperina.helper.charge">
    <description>Порог заряда батареи</description>
    <message>HYPERINA: порог заряда батареи — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">charge</annotate>
  </action>
  <action id="org.hyperina.helper.theme">
    <description>Тема экрана входа и заставки</description>
    <message>HYPERINA: тема экрана входа и заставки — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">system-theme</annotate>
  </action>
  <action id="org.hyperina.helper.locale">
    <description>Язык и форматы системы</description>
    <message>HYPERINA: язык и форматы системы — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">locale</annotate>
  </action>
  <action id="org.hyperina.helper.timezone">
    <description>Часовой пояс</description>
    <message>HYPERINA: часовой пояс — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">timezone</annotate>
  </action>
  <action id="org.hyperina.helper.ntp">
    <description>Синхронизация времени</description>
    <message>HYPERINA: синхронизация времени — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">ntp</annotate>
  </action>
  <action id="org.hyperina.helper.keymap">
    <description>Раскладка клавиатуры экрана входа</description>
    <message>HYPERINA: раскладка клавиатуры экрана входа — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">keymap</annotate>
  </action>
  <action id="org.hyperina.helper.service">
    <description>Системные службы</description>
    <message>HYPERINA: системные службы — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">service</annotate>
  </action>
  <action id="org.hyperina.helper.firewall">
    <description>Файрвол</description>
    <message>HYPERINA: файрвол — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">firewall</annotate>
  </action>
  <action id="org.hyperina.helper.snapshot">
    <description>Снимки системы и откат</description>
    <message>HYPERINA: снимки системы и откат — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">snapshot</annotate>
  </action>
  <action id="org.hyperina.helper.clean">
    <description>Очистка системы</description>
    <message>HYPERINA: очистка системы — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">clean</annotate>
  </action>
  <action id="org.hyperina.helper.hostname">
    <description>Имя компьютера</description>
    <message>HYPERINA: имя компьютера — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">hostname</annotate>
  </action>
  <action id="org.hyperina.helper.face">
    <description>Вход по лицу</description>
    <message>HYPERINA: вход по лицу — нужен пароль</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/hyperina/bin/hyperina-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">face</annotate>
  </action>
</policyconfig>
