# Genius API Credentials
GENIUS_CLIENT_ID=your_genius_client_id_here
GENIUS_CLIENT_SECRET=your_genius_client_secret_here
GENIUS_ACCESS_TOKEN=your_genius_access_token_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Browsers allowed to call this service. Comma separated, or * in development.
# A page opened straight from disk sends Origin: null, so include it if you
# double-click the single-file build.
CORS_ORIGIN=http://localhost:8099,http://127.0.0.1:8099,null

# Caching. Leave REDIS_URL empty to use the built-in in-memory cache.
REDIS_URL=
CACHE_TTL_SECONDS=21600
CACHE_MAX_ENTRIES=500

# Guard rails
GENIUS_TIMEOUT_MS=8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
