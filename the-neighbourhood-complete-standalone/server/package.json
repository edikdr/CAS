{
  "name": "nbhd-genius-service",
  "version": "1.0.0",
  "private": true,
  "description": "Genius API integration for the NBHD fan archive. Keeps the access token server-side and caches every upstream call.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
