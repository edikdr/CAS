#!/bin/bash
# Проверка конфига Hyprland в chroot от обычного пользователя: hyprverify <каталог-конфига-на-хосте>
R=/opt/archroot/root.x86_64
SRC="$1"
rm -rf "$R/home/tester/.config/hypr"; mkdir -p "$R/home/tester/.config"
cp -r "$SRC" "$R/home/tester/.config/hypr"
chroot $R /usr/bin/env -i PATH=/usr/bin bash -c "chown -R tester:tester /home/tester/.config; mkdir -p /tmp/xdg-tester; chown tester /tmp/xdg-tester; chmod 700 /tmp/xdg-tester; runuser -u tester -- env HOME=/home/tester XDG_RUNTIME_DIR=/tmp/xdg-tester LANG=C.UTF-8 timeout 30 Hyprland --verify-config -c /home/tester/.config/hypr/hyprland.lua 2>&1" | sed 's/\x1b\[[0-9;]*m//g'
